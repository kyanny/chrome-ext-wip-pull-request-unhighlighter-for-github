{
  "name": "WIP Pull Request Unhighlignter for GitHub",
  "version": "2.3.0",
  "manifest_version": 3,
  "description": "Unhighlignt WIP, DO NOT MERGE pull requests on GitHub.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*/pulls*",
    "https://github.com/pulls*"
  ],
  "options_ui": {
    "page": "options/options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/pulls*",
        "https://github.com/pulls*"
      ],
      "js": [
        "app.js"
      ]
    }
  ],
  "icons": {
    "128": "assets/icon.png"
  }
}
